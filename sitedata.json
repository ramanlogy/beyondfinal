  "faqSchema": {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the best time to climb Mount Everest?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The best seasons to climb Mount Everest are spring (April–May) and autumn (September–October). The spring season is the most popular, with stable weather windows typically occurring in mid-May. The autumn season offers cleaner skies but shorter weather windows."
        }
      },
      {
        "@type": "Question",
        "name": "How much does an Everest expedition cost?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A fully guided Everest expedition with Beyond Summit Expeditions starts from USD 45,000 per person for a supported climb. This includes the Nepal government permit ($11,000), liaison officer fees, base camp setup, oxygen, Sherpa support, and all meals at base camp."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need previous mountaineering experience for Everest?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Nepal's Department of Tourism requires climbers to have previous high-altitude experience. Beyond Summit recommends candidates have summited at least one 7000m peak and demonstrate proficiency in technical climbing skills including ice axe, crampons, and fixed rope ascent."
        }
      },
      {
        "@type": "Question",
        "name": "Is Everest Base Camp Trek suitable for beginners?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Everest Base Camp Trek (5,364m) is suitable for fit beginners with no prior mountaineering experience. The trek requires 12–14 days and good physical fitness. Proper acclimatization days are built into our itineraries to ensure your safety."
        }
      },
      {
        "@type": "Question",
        "name": "What permits are needed for trekking in Nepal?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "All trekkers in Nepal need a TIMS (Trekkers' Information Management System) card. Restricted area treks like Upper Mustang and Manaslu require special restricted area permits. Sagarmatha (Everest) and Annapurna zones require National Park entry permits. Beyond Summit handles all permits on behalf of clients."
        }
      },
      {
        "@type": "Question",
        "name": "What is included in your trekking packages?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Our trekking packages include airport transfers, accommodation (teahouse or camping), all meals on trek, licensed trek guides, porters, all permits, first aid kit, and 24/7 emergency support. International flights and travel insurance are not included."
        }
      }
    ]
  },

